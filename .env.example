# Required: your Vapi private API key (dashboard -> API Keys)
VAPI_API_KEY=

# Optional overrides (defaults live in src/config.ts)
# MODEL_PROVIDER=openai
# MODEL=gpt-4.1
# VOICE_ID=Clara

# Where transfers go (a real phone). Leave empty to use a free Vapi SIP line answered by a stand-in assistant.
# LICENSED_AGENT_PHONE=+14155550000

# Optional: your phone; calls from it match the "Sam Carter" record. Any phone works if you say "Sam Carter".
# DEMO_CALLER_PHONE=+14155550000

# Warm transfer modes need Twilio telephony. Free Vapi numbers: blind-transfer.
# TRANSFER_MODE=blind-transfer

# Area codes to try when provisioning free Vapi numbers
# AREA_CODES=650,415,628,510,408
